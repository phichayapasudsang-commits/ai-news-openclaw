# ===== Supabase (frontend-safe keys only) =====
# Public URL + ANON key are safe to ship in the browser bundle.
# Get them from: https://supabase.com/dashboard -> Project -> Settings -> API

# Project URL, looks like: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# anon / public key (NOT the service_role key!)
VITE_SUPABASE_ANON_KEY=

# ===== Demo mode =====
# Set to "1" to skip Supabase and serve 6 static sample articles.
# Great for previewing the UI before the pipeline has real data.
# Remove this line (or set to 0) to switch back to live Supabase reads.
# VITE_USE_MOCK=1
