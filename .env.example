# ===== OpenAI (or any OpenAI-compatible endpoint) =====
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the base URL when using a proxy (tokenmind, Azure, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1
# Model name (defaults to gpt-4o-mini if unset)
# OPENAI_MODEL_NAME=gpt-4o-mini
# Embedding model for the Deduplicator (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Firecrawl =====
# Get it from: https://www.firecrawl.dev (sign in -> API Keys)
FIRECRAWL_API_KEY=

# ===== Google Programmable Search (optional) =====
# Get them from: https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# ===== Supabase =====
# Get them from: https://supabase.com/dashboard -> Project -> Settings -> API
# SUPABASE_URL looks like: https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Service role key bypasses Row Level Security - NEVER expose to the client side.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Pipeline tuning =====
# Cosine similarity threshold for clustering duplicate articles (0-1)
DEDUP_SIMILARITY_THRESHOLD=0.85
# Cache window in days for the Deduplicator
DEDUP_CACHE_DAYS=2
# Default topic for the Researcher when TOPIC env is not set
TOPIC="Agent memory MCP research"
