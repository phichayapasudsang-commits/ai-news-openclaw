# =============================================================================
# ai-news-agent — .dockerignore
# =============================================================================
# Keep the build context small and prevent secrets from leaking into the image.

# Anything that isn't needed to RUN digest.js goes here.

# Local installs / build output (rebuilt inside the image).
node_modules
dist
.cache

# Runtime data we don't want baked in.
logs
*.log

# Secrets — never bake .env into the image. Compose mounts it via env_file.
.env
.env.*
!.env.example

# The web/ and supabase/ directories are out of scope for this image.
web
supabase
db

# Tests and tooling not needed at runtime.
test
tests
**/*.test.ts
**/*.spec.ts
**/*.tsbuildinfo

# VCS + editor noise.
.git
.gitignore
.gitattributes
.github
.idea
.vscode
.DS_Store

# Docs that aren't needed inside the image.
*.md
!docker/README.md
README.md
LICENSE
